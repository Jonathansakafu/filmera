<resources>
    <style name="Theme.Filmera" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/filmera_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Filmera.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/filmera_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Filmera</item>
    </style>
</resources>
